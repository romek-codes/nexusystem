{
  "model": "sonnet",
  "permissions": {
    "defaultMode": "auto",
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh release *)",
      "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
      "mcp__claude_ai_Atlassian__addWorklogToJiraIssue",
      "mcp__claude_ai_Atlassian__transitionJiraIssue",
      "mcp__claude_ai_Atlassian__editJiraIssue",
      "mcp__claude_ai_Atlassian__createJiraIssue",
      "mcp__claude_ai_Atlassian__createIssueLink",
      "mcp__atlassian__addOrEditJiraIssueComment",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__executeWrite",
      "mcp__atlassian__executeDestructive"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/guard.sh claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/romek/Workspace/nexusystem/home/programs/agents/agent-notify.py claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/romek/Workspace/nexusystem/home/programs/agents/agent-notify.py claude"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/romek/Workspace/nexusystem/home/programs/agents/agent-notify.py claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "editorMode": "vim",
  "voiceEnabled": true,
  "preferredNotifChannel": "notifications_disabled"
}
